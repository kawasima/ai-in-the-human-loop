{
  "name": "ai-in-the-human-loop",
  "description": "Run the HUMAN.md feedback loop in any repository: a human-feedback skill, a /triage command, and SessionStart + Stop hooks that surface and capture human-side friction.",
  "version": "0.1.0",
  "author": {
    "name": "kawasima"
  },
  "homepage": "https://github.com/kawasima/ai-in-the-human-loop",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop-reminder.sh\""
          }
        ]
      }
    ]
  }
}
